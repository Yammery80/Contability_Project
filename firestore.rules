rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES GENERALES
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function myRole() {
      return myProfile().role;
    }

    function isActive() {
      return myProfile().active == true;
    }

    function hasAnyRole(roles) {
      return isSignedIn()
        && isActive()
        && myRole() in roles;
    }

    // ==========================================
    // USUARIOS
    // ==========================================

    match /users/{userId} {

      allow read: if isSignedIn()
        && (
          request.auth.uid == userId ||
          isActive()
        );

      allow create: if hasAnyRole(['SUPERUSER'])
        || (
          hasAnyRole(['ADMIN'])
          && request.resource.data.role != 'SUPERUSER'
        );

      allow update: if hasAnyRole(['SUPERUSER'])
        || (
          hasAnyRole(['ADMIN'])
          && resource.data.role != 'SUPERUSER'
          && request.resource.data.role != 'SUPERUSER'
        );

      allow delete: if hasAnyRole(['SUPERUSER']);
    }

    // ==========================================
    // CLIENTES
    // ==========================================

    match /clients/{clientId} {

      allow read: if hasAnyRole([
        'OPERATOR',
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      allow write: if hasAnyRole([
        'ADMIN',
        'SUPERUSER'
      ]);
    }

    // ==========================================
    // PROYECTOS
    // ==========================================

    match /projects/{projectId} {

      allow read: if hasAnyRole([
        'OPERATOR',
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      allow write: if hasAnyRole([
        'ADMIN',
        'SUPERUSER'
      ]);
    }

    // ==========================================
    // TAREAS
    // ==========================================

    match /tasks/{taskId} {

      function isAssignedOperator() {
        return hasAnyRole(['OPERATOR'])
          && resource.data.assignedUserId == request.auth.uid;
      }

      function operatorAllowedFields() {
        return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'completedAt',
            'completedBy',
            'completionHistory',
            'comments',
            'subtasks'
          ]);
      }

      function validOperatorStatus() {
        return request.resource.data.status in [
          'PENDING',
          'IN_PROGRESS',
          'COMPLETED'
        ]
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny([
              'status',
              'completedAt',
              'completedBy',
              'completionHistory'
            ])
          || (
            request.resource.data.status == 'COMPLETED'
            && request.resource.data.completedBy == request.auth.uid
          )
          || (
            request.resource.data.status != 'COMPLETED'
            && request.resource.data.completedBy == ''
            && request.resource.data.completedAt == 0
          )
        );
      }

      function validOperatorComments() {
        return !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['comments'])
          || (
            request.resource.data.comments is list
            && resource.data.comments is list
            && request.resource.data.comments.size()
              == resource.data.comments.size() + 1
            && request.resource.data.comments[
              resource.data.comments.size()
            ].userId == request.auth.uid
            && request.resource.data.comments[
              resource.data.comments.size()
            ].id is string
            && request.resource.data.comments[
              resource.data.comments.size()
            ].text is string
          );
      }

      function validOperatorSubtasks() {
        return !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['subtasks'])
          || request.resource.data.subtasks is list;
      }

      allow read: if hasAnyRole([
        'OPERATOR',
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      // Crear tareas.
      allow create: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      // Editar tareas.
      allow update: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ])
      || (
        isAssignedOperator()
        && operatorAllowedFields()
        && validOperatorStatus()
        && validOperatorComments()
        && validOperatorSubtasks()
      );

      allow delete: if hasAnyRole([
        'ADMIN',
        'SUPERUSER'
      ]);
    }

    function reviewer() {
      return hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']);
    }

    function validManual(e) {
      return e.keys().hasAll(['userId','clientId','projectId','taskId','description','type','status','startTime','endTime','duration'])
        && e.keys().size() == 10
        && e.userId == request.auth.uid && e.type == 'MANUAL' && e.status == 'STOPPED'
        && e.clientId is string && e.projectId is string && e.taskId is string
        && e.description is string && e.description.matches('(?s).*[^[:space:]].*') && e.description.size() <= 1000
        && e.startTime is int && e.endTime is int && e.startTime > 0
        && e.endTime <= request.time.toMillis() && e.endTime > e.startTime
        && e.duration is int && e.duration * 1000 == e.endTime - e.startTime;
    }

    function matchesApproval(id, entry) {
      let req = getAfter(/databases/$(database)/documents/lateTimeRequests/$(id)).data;
      return req.status == 'APPROVED' && req.reviewedAt == request.time
        && req.reviewedBy == request.auth.uid && req.entry.userId != request.auth.uid
        && entry.authorizationId == id && entry.diff(req.entry).affectedKeys().hasOnly(['authorizationId']);
    }

    match /lateTimeRequests/{id} {
      allow read: if reviewer() || (isSignedIn() && isActive() && resource.data.entry.userId == request.auth.uid);
      allow create: if isSignedIn() && isActive()
        && request.resource.data.keys().hasOnly(['entry','reason','status','requestedAt'])
        && validManual(request.resource.data.entry)
        && request.resource.data.status == 'PENDING' && request.resource.data.requestedAt == request.time
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 1000
        && request.resource.data.reason.matches('(?s).*[^[:space:]].*');
      allow update: if reviewer() && resource.data.entry.userId != request.auth.uid
        && resource.data.status == 'PENDING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'REJECTED' ||
          (request.resource.data.status == 'APPROVED'
           && !exists(/databases/$(database)/documents/timeEntries/$(id))
           && getAfter(/databases/$(database)/documents/timeEntries/$(id)).data.authorizationId == id));
    }

    // El cronómetro usa milisegundos del navegador. Admitir un pequeño desfase de reloj.
    function nearNow(ms) {
      return ms is int && ms >= request.time.toMillis() - 60000 && ms <= request.time.toMillis() + 60000;
    }

    function timerTransition(old, next) {
      let finishing = next.status == 'STOPPED' && nearNow(next.endTime);
      let pausing = next.status == 'PAUSED' && next.endTime == null;
      return next.diff(old).affectedKeys().hasOnly(['startTime','endTime','duration','status'])
        && ((old.status == 'PAUSED' && next.status == 'RUNNING' && nearNow(next.startTime)
             && next.duration == old.duration && next.endTime == null)
          || (next.startTime == null && (finishing || pausing)
              && ((old.status == 'PAUSED' && finishing && next.duration == old.duration)
                || (old.status == 'RUNNING' && next.duration is int && next.duration >= old.duration
                    && (next.duration - old.duration) * 1000 <= request.time.toMillis() - old.startTime + 60000))));
    }

    match /timeEntries/{entryId} {
      allow read: if reviewer() || (isSignedIn() && isActive() && resource.data.userId == request.auth.uid);
      allow create: if (isSignedIn() && isActive() && request.resource.data.userId == request.auth.uid
          && request.resource.data.type == 'TIMER' && request.resource.data.status == 'RUNNING'
          && nearNow(request.resource.data.startTime) && request.resource.data.endTime == null
          && request.resource.data.duration == 0 && !('authorizationId' in request.resource.data))
        || (reviewer() && matchesApproval(entryId, request.resource.data));
      allow update: if isSignedIn() && isActive() && resource.data.userId == request.auth.uid
        && resource.data.type == 'TIMER' && timerTransition(resource.data, request.resource.data);
      allow delete: if !('authorizationId' in resource.data) && (reviewer()
        || (isSignedIn() && isActive() && resource.data.userId == request.auth.uid));
    }

    // ==========================================
    // OBLIGACIONES
    // ==========================================

    match /obligations/{obligationId} {

      allow read: if hasAnyRole([
        'OPERATOR',
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      allow create, delete: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      allow update: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ])
      || (
        hasAnyRole(['OPERATOR'])
        && resource.data.assignedUserId == request.auth.uid
        && resource.data.status != 'DONE'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'completedBy', 'completedByName', 'completionHistory'
        ])
        && (
          (request.resource.data.status in ['PENDING', 'IN_PROGRESS', 'OVERDUE']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (
            request.resource.data.status == 'DONE'
            && request.resource.data.completedBy == request.auth.uid
            && request.resource.data.completedAt is int
            && request.resource.data.completionHistory is list
            && request.resource.data.completionHistory.size() ==
              resource.data.get('completionHistory', []).size() + 1
          )
        )
      );
    }

    // ==========================================
    // NOTIFICACIONES
    // ==========================================

    match /notifications/{notificationId} {

      // Solo el destinatario puede leerlas.
      allow read: if isSignedIn()
        && isActive()
        && resource.data.userId == request.auth.uid;

      // Solo Cloud Functions / Admin SDK las crea.
      allow create: if false;

      // Solo se permite marcarlas como leidas.
      allow update: if isSignedIn()
        && isActive()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['read'])
        && request.resource.data.read == true;

      allow delete: if hasAnyRole([
        'ADMIN',
        'SUPERUSER'
      ]);
    }

    // ==========================================
    // HU-41: CONFIGURACION DEL SEMAFORO
    // ==========================================

    match /settings/{settingId} {

      // Todos los usuarios activos pueden consultar el semaforo.
      allow read: if settingId == 'semaphore'
        && hasAnyRole([
          'OPERATOR',
          'SUPERVISOR',
          'ADMIN',
          'SUPERUSER'
        ]);

      // Solo administradores pueden configurar los rangos.
      allow create, update: if settingId == 'semaphore'
        && hasAnyRole(['ADMIN', 'SUPERUSER'])
        && request.resource.data.keys().hasOnly([
          'redDays',
          'yellowDays'
        ])
        && request.resource.data.keys().hasAll([
          'redDays',
          'yellowDays'
        ])
        && request.resource.data.redDays is int
        && request.resource.data.yellowDays is int
        && request.resource.data.redDays >= 0
        && request.resource.data.redDays < request.resource.data.yellowDays
        && request.resource.data.yellowDays <= 365;

      // No se permite eliminar la configuracion.
      allow delete: if false;
    }

  }
}

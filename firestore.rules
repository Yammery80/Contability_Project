rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return myProfile().role;
    }

    function isActive() {
      return myProfile().active == true;
    }

    // Roles válidos: SUPERUSER, ADMIN, SUPERVISOR, OPERATOR (HU-06).
    // No existe un rol "CLIENT": el cliente del despacho nunca inicia
    // sesión, solo vive como registro en la colección /clients.
    function hasAnyRole(roles) {
      return isSignedIn() && isActive() && myRole() in roles;
    }

    // Perfil propio: cualquier usuario autenticado puede leer su propio doc
    // (necesario para resolver el rol al iniciar sesión). Administrar
    // usuarios (crear/editar/desactivar/asignar rol) es de SUPERUSER y
    // ADMIN según HU-02 a HU-06.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']));
      allow write: if hasAnyRole(['ADMIN','SUPERUSER']);
    }

    match /clients/{clientId} {
      allow read: if hasAnyRole(['OPERATOR','SUPERVISOR','ADMIN','SUPERUSER']);
      allow write: if hasAnyRole(['ADMIN','SUPERUSER']);
    }

    match /projects/{projectId} {
      allow read: if hasAnyRole(['OPERATOR','SUPERVISOR','ADMIN','SUPERUSER']);
      allow write: if hasAnyRole(['ADMIN','SUPERUSER']);
    }

    match /tasks/{taskId} {
      allow read: if hasAnyRole(['OPERATOR','SUPERVISOR','ADMIN','SUPERUSER']);
      // Crear/asignar tareas: Administrador o Supervisor (HU-19, HU-20).
      // El Operador solo puede actualizar su propio estado de tarea (HU-22).
      allow create: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']);
      allow update: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']) ||
        (hasAnyRole(['OPERATOR']) && resource.data.assignedUserId == request.auth.uid);
      allow delete: if hasAnyRole(['ADMIN','SUPERUSER']);
    }

    match /timeEntries/{entryId} {
      allow read: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']) ||
        (isSignedIn() && isActive() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isActive() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']) ||
        (isSignedIn() && isActive() && resource.data.userId == request.auth.uid);
    }

    match /obligations/{obligationId} {
      allow read: if hasAnyRole(['OPERATOR','SUPERVISOR','ADMIN','SUPERUSER']);
      // Registrar/asignar obligación: Administrador o Supervisor (HU-33, HU-34).
      // Completar (HU-37) la puede hacer también el Operador responsable.
      allow create, delete: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']);
      allow update: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']) ||
        (hasAnyRole(['OPERATOR']) && resource.data.assignedUserId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && isActive() && resource.data.userId == request.auth.uid;
      allow create: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']);
      allow delete: if hasAnyRole(['ADMIN','SUPERUSER']);
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES GENERALES
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function myRole() {
      return myProfile().role;
    }

    function isActive() {
      return myProfile().active == true;
    }

    function hasAnyRole(roles) {
      return isSignedIn()
        && isActive()
        && myRole() in roles;
    }

    // ==========================================
    // USUARIOS
    // ==========================================

    match /users/{userId} {

      allow read: if isSignedIn()
        && (
          request.auth.uid == userId ||
          isActive()
        );

      allow create: if hasAnyRole(['SUPERUSER'])
        || (
          hasAnyRole(['ADMIN'])
          && request.resource.data.role != 'SUPERUSER'
        );

      allow update: if hasAnyRole(['SUPERUSER'])
        || (
          hasAnyRole(['ADMIN'])
          && resource.data.role != 'SUPERUSER'
          && request.resource.data.role != 'SUPERUSER'
        );

      allow delete: if hasAnyRole(['SUPERUSER']);
    }

    // ==========================================
    // CLIENTES
    // ==========================================

    match /clients/{clientId} {

      allow read: if hasAnyRole([
        'OPERATOR',
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      allow write: if hasAnyRole([
        'ADMIN',
        'SUPERUSER'
      ]);
    }

    // ==========================================
    // PROYECTOS
    // ==========================================

    match /projects/{projectId} {

      allow read: if hasAnyRole([
        'OPERATOR',
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      allow write: if hasAnyRole([
        'ADMIN',
        'SUPERUSER'
      ]);
    }

    // ==========================================
    // TAREAS
    // ==========================================

    match /tasks/{taskId} {

      function isAssignedOperator() {
        return hasAnyRole(['OPERATOR'])
          && resource.data.assignedUserId == request.auth.uid;
      }

      function operatorAllowedFields() {
        return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'completedAt',
            'completedBy',
            'completionHistory',
            'comments',
            'subtasks'
          ]);
      }

      function validOperatorStatus() {
        return request.resource.data.status in [
          'PENDING',
          'IN_PROGRESS',
          'COMPLETED'
        ]
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny([
              'status',
              'completedAt',
              'completedBy',
              'completionHistory'
            ])
          || (
            request.resource.data.status == 'COMPLETED'
            && request.resource.data.completedBy == request.auth.uid
          )
          || (
            request.resource.data.status != 'COMPLETED'
            && request.resource.data.completedBy == ''
            && request.resource.data.completedAt == 0
          )
        );
      }

      function validOperatorComments() {
        return !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['comments'])
          || (
            request.resource.data.comments is list
            && resource.data.comments is list
            && request.resource.data.comments.size()
              == resource.data.comments.size() + 1
            && request.resource.data.comments[
              resource.data.comments.size()
            ].userId == request.auth.uid
            && request.resource.data.comments[
              resource.data.comments.size()
            ].id is string
            && request.resource.data.comments[
              resource.data.comments.size()
            ].text is string
          );
      }

      function validOperatorSubtasks() {
        return !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['subtasks'])
          || request.resource.data.subtasks is list;
      }

      allow read: if hasAnyRole([
        'OPERATOR',
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      // Crear tareas.
      allow create: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      // Editar tareas.
      allow update: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ])
      || (
        isAssignedOperator()
        && operatorAllowedFields()
        && validOperatorStatus()
        && validOperatorComments()
        && validOperatorSubtasks()
      );

      allow delete: if hasAnyRole([
        'ADMIN',
        'SUPERUSER'
      ]);
    }

    // ==========================================
    // REGISTROS DE TIEMPO
    // ==========================================

    match /timeEntries/{entryId} {

      allow read: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ])
      || (
        isSignedIn()
        && isActive()
        && resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn()
        && isActive()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ])
      || (
        isSignedIn()
        && isActive()
        && resource.data.userId == request.auth.uid
      );
    }

    // ==========================================
    // OBLIGACIONES
    // ==========================================

    match /obligations/{obligationId} {

      allow read: if hasAnyRole([
        'OPERATOR',
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      allow create, delete: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ]);

      allow update: if hasAnyRole([
        'SUPERVISOR',
        'ADMIN',
        'SUPERUSER'
      ])
      || (
        hasAnyRole(['OPERATOR'])
        && resource.data.assignedUserId == request.auth.uid
      );
    }

    // ==========================================
    // NOTIFICACIONES
    // ==========================================

    match /notifications/{notificationId} {

      // Solo el destinatario puede leerlas.
      allow read: if isSignedIn()
        && isActive()
        && resource.data.userId == request.auth.uid;

      // Solo Cloud Functions / Admin SDK las crea.
      allow create: if false;

      // Solo se permite marcarlas como leidas.
      allow update: if isSignedIn()
        && isActive()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['read'])
        && request.resource.data.read == true;

      allow delete: if hasAnyRole([
        'ADMIN',
        'SUPERUSER'
      ]);
    }
  }
}

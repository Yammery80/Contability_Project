rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return myProfile().role;
    }

    function isActive() {
      return myProfile().active == true;
    }

    // Roles válidos: SUPERUSER, ADMIN, SUPERVISOR, OPERATOR (HU-06).
    // No existe un rol "CLIENT": el cliente del despacho nunca inicia
    // sesión, solo vive como registro en la colección /clients.
    function hasAnyRole(roles) {
      return isSignedIn() && isActive() && myRole() in roles;
    }

    // Usuarios:
    // - Lectura: cualquier usuario ACTIVO puede leer perfiles (el Operador
    //   necesita ver los nombres de sus compañeros en tareas y comentarios).
    //   Un usuario siempre puede leer su propio perfil, incluso antes de
    //   validar si está activo (así se resuelve su rol al iniciar sesión).
    //   OJO: esto también expone correo y teléfono de los colegas a cualquier
    //   usuario activo.
    // - Alta/edición: SUPERUSER todo; ADMIN no puede crear ni modificar
    //   cuentas de SUPERUSER ni asignar ese rol.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isActive());

      allow create: if hasAnyRole(['SUPERUSER'])
        || (hasAnyRole(['ADMIN']) && request.resource.data.role != 'SUPERUSER');

      allow update: if (isSignedIn() && isActive() && request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','position','mustChangePassword'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['mustChangePassword'])
                || request.resource.data.mustChangePassword == false))
        || hasAnyRole(['SUPERUSER'])
        || (hasAnyRole(['ADMIN'])
            && resource.data.role != 'SUPERUSER'
            && request.resource.data.role != 'SUPERUSER');

      allow delete: if hasAnyRole(['SUPERUSER']);
    }

    match /clients/{clientId} {
      allow read: if hasAnyRole(['OPERATOR','SUPERVISOR','ADMIN','SUPERUSER']);
      allow write: if hasAnyRole(['ADMIN','SUPERUSER']);
    }

    match /projects/{projectId} {
      allow read: if hasAnyRole(['OPERATOR','SUPERVISOR','ADMIN','SUPERUSER']);
      allow write: if hasAnyRole(['ADMIN','SUPERUSER']);
    }

    match /tasks/{taskId} {
      allow read: if hasAnyRole(['OPERATOR','SUPERVISOR','ADMIN','SUPERUSER']);
      // Crear/asignar tareas: Administrador o Supervisor (HU-19, HU-20).
      // El Operador solo puede actualizar su propio estado de tarea (HU-22).
      allow create: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']);
      allow update: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']) ||
        (hasAnyRole(['OPERATOR']) && resource.data.assignedUserId == request.auth.uid);
      allow delete: if hasAnyRole(['ADMIN','SUPERUSER']);
    }

    function reviewer() {
      return hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']);
    }

    function validManual(e) {
      return e.keys().hasAll(['userId','clientId','projectId','taskId','description','type','status','startTime','endTime','duration'])
        && e.keys().size() == 10
        && e.userId == request.auth.uid && e.type == 'MANUAL' && e.status == 'STOPPED'
        && e.clientId is string && e.projectId is string && e.taskId is string
        && e.description is string && e.description.size() <= 1000
        && e.startTime is int && e.endTime is int && e.startTime > 0
        && e.endTime <= request.time.toMillis() && e.endTime > e.startTime
        && e.duration is int && e.duration * 1000 == e.endTime - e.startTime;
    }

    function matchesApproval(id, entry) {
      let req = getAfter(/databases/$(database)/documents/lateTimeRequests/$(id)).data;
      return req.status == 'APPROVED' && req.reviewedAt == request.time
        && req.reviewedBy == request.auth.uid && req.entry.userId != request.auth.uid
        && entry.authorizationId == id && entry.diff(req.entry).affectedKeys().hasOnly(['authorizationId']);
    }

    match /lateTimeRequests/{id} {
      allow read: if reviewer() || (isSignedIn() && isActive() && resource.data.entry.userId == request.auth.uid);
      allow create: if isSignedIn() && isActive()
        && validManual(request.resource.data.entry)
        && request.resource.data.status == 'PENDING' && request.resource.data.requestedAt == request.time
        && ((request.resource.data.keys().hasOnly(['entry','kind','status','requestedAt'])
             && request.resource.data.get('kind', '') == 'STANDARD')
          || (request.resource.data.keys().hasOnly(['entry','reason','status','requestedAt'])
              && request.resource.data.entry.description.matches('(?s).*[^[:space:]].*')
              && request.resource.data.reason is string && request.resource.data.reason.size() <= 1000
              && request.resource.data.reason.matches('(?s).*[^[:space:]].*')));
      allow update: if reviewer() && resource.data.entry.userId != request.auth.uid
        && resource.data.status == 'PENDING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt'])
        && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time
        && (request.resource.data.status == 'REJECTED' ||
          (request.resource.data.status == 'APPROVED'
           && !exists(/databases/$(database)/documents/timeEntries/$(id))
           && getAfter(/databases/$(database)/documents/timeEntries/$(id)).data.authorizationId == id));
    }

    // El cronómetro usa milisegundos del navegador. Admitir un pequeño desfase de reloj.
    function nearNow(ms) {
      return ms is int && ms >= request.time.toMillis() - 60000 && ms <= request.time.toMillis() + 60000;
    }

    function timerTransition(old, next) {
      let finishing = next.status == 'STOPPED' && nearNow(next.endTime);
      let pausing = next.status == 'PAUSED' && next.endTime == null;
      return next.diff(old).affectedKeys().hasOnly(['startTime','endTime','duration','status'])
        && ((old.status == 'PAUSED' && next.status == 'RUNNING' && nearNow(next.startTime)
             && next.duration == old.duration && next.endTime == null)
          || (next.startTime == null && (finishing || pausing)
              && ((old.status == 'PAUSED' && finishing && next.duration == old.duration)
                || (old.status == 'RUNNING' && next.duration is int && next.duration >= old.duration
                    && (next.duration - old.duration) * 1000 <= request.time.toMillis() - old.startTime + 60000))));
    }

    match /timeEntries/{entryId} {
      allow read: if reviewer() || (isSignedIn() && isActive() && resource.data.userId == request.auth.uid);
      allow create: if (isSignedIn() && isActive() && request.resource.data.userId == request.auth.uid
          && request.resource.data.type == 'TIMER' && request.resource.data.status == 'RUNNING'
          && nearNow(request.resource.data.startTime) && request.resource.data.endTime == null
          && request.resource.data.duration == 0 && !('authorizationId' in request.resource.data))
        || (reviewer() && matchesApproval(entryId, request.resource.data));
      allow update: if isSignedIn() && isActive() && resource.data.userId == request.auth.uid
        && resource.data.type == 'TIMER' && timerTransition(resource.data, request.resource.data);
      allow delete: if !('authorizationId' in resource.data) && (reviewer()
        || (isSignedIn() && isActive() && resource.data.userId == request.auth.uid));
    }

    match /obligations/{obligationId} {
      allow read: if hasAnyRole(['OPERATOR','SUPERVISOR','ADMIN','SUPERUSER']);
      // Registrar/asignar obligación: Administrador o Supervisor (HU-33, HU-34).
      // Completar (HU-37) la puede hacer también el Operador responsable.
      allow create, delete: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']);
      allow update: if hasAnyRole(['SUPERVISOR','ADMIN','SUPERUSER']) ||
        (hasAnyRole(['OPERATOR']) && resource.data.assignedUserId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      // Cada quien solo lee y marca como leídas SUS notificaciones.
      allow read, update: if isSignedIn() && isActive() && resource.data.userId == request.auth.uid;

      // Cualquier usuario activo puede avisar a otro (p. ej. el Operador al
      // completar o comentar una tarea), pero solo con la forma esperada.
      allow create: if isSignedIn() && isActive()
        && request.resource.data.keys().hasOnly(['userId','title','message','level','read','createdAt'])
        && request.resource.data.userId is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.level in ['INFO','WARNING','URGENT']
        && request.resource.data.read == false;

      allow delete: if hasAnyRole(['ADMIN','SUPERUSER']);
    }

    match /activities/{activityId} {
      allow read, delete: if isSignedIn() && isActive() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','domain','title','startTime','endTime','duration','source','createdAt'])
        && request.resource.data.domain is string && request.resource.data.domain.size() <= 255
        && request.resource.data.title is string && request.resource.data.title.size() <= 500
        && request.resource.data.startTime is number && request.resource.data.endTime is number
        && request.resource.data.duration is number
        && request.resource.data.source in ['chrome','desktop','google','microsoft'];
      allow update: if isSignedIn() && isActive()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.keys().hasOnly(['userId','domain','title','startTime','endTime','duration','source','createdAt']);
    }

    match /trackedApps/{appId} {
      allow read: if isSignedIn() && isActive();
      allow create, update: if hasAnyRole(['ADMIN','SUPERUSER'])
        && request.resource.data.keys().hasOnly(['name','domain','active','createdAt','createdBy'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 255
        && request.resource.data.domain is string && request.resource.data.domain.size() <= 255
        && request.resource.data.active is bool;
      allow delete: if hasAnyRole(['ADMIN','SUPERUSER']);
    }
  }
}
